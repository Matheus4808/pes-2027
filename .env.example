# Modelo das variáveis do site. Copie para .env (fica fora do git) e preencha.
# Campo vazio = o site mostra a alternativa (lista de espera / pré-venda).
#
# Tudo com prefixo VITE_ vira PÚBLICO no JavaScript do site (qualquer um lê no navegador).
# Nunca use VITE_ para segredos (chaves do R2, service_role do Supabase, tokens, senhas).
# No GitHub: Settings > Secrets and variables > Actions > Variables (mesmos nomes).

# ---------------------------------------------------------- público
VITE_BETA_URL=
VITE_CHECKOUT_URL=
VITE_PRICE=
VITE_PRICE_FROM=
VITE_LEAD_ENDPOINT=
VITE_CONTACT_EMAIL=
VITE_DISCORD_URL=
VITE_YOUTUBE_URL=
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------- privado (sem VITE_, nunca chega ao site)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SUPABASE_SERVICE_ROLE_KEY=
